# Copy to .env.testing — used by `php artisan … --env=testing` and must NOT point at your dev DB.
# cp .env.testing.example .env.testing

APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Never set DB_ALLOW_DESTRUCTIVE on your main .env unless you are intentionally wiping that database.
